    "note": "Luật theo báo cáo; văn bản hồ sơ và lời thoại được biên soạn theo canon."
  },
  "contract": {
    "requirements": "all/any/not đệ quy; document/fact/hypothesis thuộc kiến thức; flag thuộc vòng hiện tại; trust_gte/trust_eq so sánh trust; input_* là kết quả diễn giải đã được người chơi xác nhận. all rỗng là đúng.",
    "effects": "Thêm ID vào tập, không nhân bản. trust_event_id chỉ áp dụng một lần mỗi vòng; trust giới hạn 0–4.",
    "repeats": "once_per_loop chặn áp dụng và thu phí lại. Hồ sơ đã phân tích đọc lại miễn phí. Hành động miễn phí không tiến triển không tạo điểm thưởng.",
    "cost": "Số nguyên phút; remaining_until_deadline nghĩa là 30 trừ elapsed_minutes.",
    "evidence": "Thẻ và AI phải cung cấp cùng các facts trong evidence_requirements và mệnh đề đúng; tên hồ sơ đơn lẻ không đủ.",
    "order": [
      "validate_and_confirm",
      "reject_insufficient_time",
      "trigger_crossed_events_once",
      "apply_effects",
      "check_win",
      "check_timeout",
      "commit"
    ],
    "deadline": "Hoàn tất đúng phút 30 xét thắng trước hết giờ; không reset giữa lúc xử lý events và effects.",
    "private_ack": "Cờ private_ack ánh xạ tới GameState.private_ack.",
    "presented_evidence": "present_h1, present_h2, private_promise lần lượt thêm H1, H2, D06 vào presented_evidence.",
    "guard_contact": "Chỉ mở sau guard_found; Lan và Hậu chỉ xuất hiện qua lời tường thuật của Hải."
  },
