  "author_only_timeline": [
    {
      "time": "22:30",
      "text": "Bến đóng điểm đón trạm 4, không cấm dừng cứu người."
    },
    {
      "time": "22:40",
      "text": "Người gác cầu ngã khi đem đèn cảnh báo ra đường, bộ đàm hỏng."
    },
    {
      "time": "22:42–22:46",
      "text": "Hải giúp người lạ vào mái trạm, để nước rồi tiếp tục; chưa biết rõ cầu hỏng."
    },
    {
      "time": "22:47",
      "text": "Xe cách trạm 300 m, đi chậm chờ xe ngược chiều; kênh của Minh mở."
    },
    {
      "time": "23:17",
      "text": "Dòng gốc: xe lên cầu, bốn hành khách tử nạn, Hải sống sót. Dòng can thiệp: cả nhóm tới chòi thì thoát. Không kết luận lịch sử hiện tại đổi."
    }
